  'environment/system.hh',
  'eval-cache.hh',
  'eval-error.hh',
  'eval-gc.hh',
  'eval-inline.hh',
  'eval-profiler-settings.hh',
  'eval-profiler.hh',
  'arg-cell.hh',
  'eval-settings.hh',
  'eval.hh',
  'evaluation-helpers.hh',
  'evaluator.hh',
  'expr-from-object.hh',
  'fetch-tree.hh',
  'file-hash-cache.hh',
  'function-trace.hh',
  'gc-small-vector.hh',
  'get-drvs.hh',
  'interpreter-object.hh',
  'interpreter.hh',
  'json-to-value.hh',
  'nixexpr.hh',
  'object-type.hh',
  'parser-state.hh',
  'primops.hh',
  'print-ambiguous.hh',
  'print-options.hh',
  'print.hh',
  'provenance-object.hh',
  'q-state.hh',
  'tracing-callback-apply-result.hh',
  'replay-callback-arg.hh',
  'repl-exit-status.hh',
  'search-path.hh',
  'source-root.hh',
  'static-string-data.hh',
  'symbol-table.hh',
  'trace-file.hh',
  'trace-ids.hh',
  'trace-sink.hh',
  'trace-types.hh',
  'tracing-cache-log.hh',
  'tracing-cache-stats.hh',
  'tracing-decision-graph.hh',
  'tracing-environment.hh',
  'tracing-evaluator.hh',
  'tracing-callback-arg.hh',
  'tracing-object.hh',
  'tracing-replay-evaluator.hh',
  'tracing-replay-object.hh',
  'tracing-source-accessor.hh',
  'tracing-writer.hh',
