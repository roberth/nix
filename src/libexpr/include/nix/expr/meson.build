# Public headers directory

include_dirs = [ include_directories('../..') ]

config_pub_h = configure_file(
  configuration : configdata_pub,
  output : 'config.hh',
)

headers = [ config_pub_h ] + files(
  'outer-object.hh',
  'attr-path.hh',
  'observation-set.hh',
  'attr-set.hh',
  'coarse-eval-cache-object.hh',
  'coarse-eval-cache.hh',
